---
const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="AI ETTÄ! etusivu">
    <img src="/images/ai-etta-logo.webp" alt="AI ETTÄ!" width="400" height="200" decoding="async" />
  </a>
  <nav aria-label="Päänavigaatio">
    <a aria-current={currentPath === '/tapahtumat/' ? 'page' : undefined} href="/#tulevat">Tapahtumat</a>
    <a aria-current={currentPath === '/oivallukset/' ? 'page' : undefined} href="/oivallukset/">Oivallukset</a>
    <a aria-current={currentPath === '/uutiset/' ? 'page' : undefined} href="/uutiset/">Uutiset</a>
    <a aria-current={currentPath === '/stagella/' ? 'page' : undefined} href="/stagella/">Stagella</a>
    <a aria-current={currentPath === '/yrityksille/' ? 'page' : undefined} href="/yrityksille/">Yrityksille</a>
    <a aria-current={currentPath === '/mika-ai-etta/' ? 'page' : undefined} href="/mika-ai-etta/">Mikä AI ETTÄ!?</a>
  </nav>
  <details class="mobile-nav">
    <summary aria-label="Avaa navigaatio"><span></span><span></span><span></span></summary>
    <nav aria-label="Mobiilinavigaatio">
      <a aria-current={currentPath === '/tapahtumat/' ? 'page' : undefined} href="/#tulevat">Tapahtumat</a>
      <a aria-current={currentPath === '/oivallukset/' ? 'page' : undefined} href="/oivallukset/">Oivallukset</a>
      <a aria-current={currentPath === '/uutiset/' ? 'page' : undefined} href="/uutiset/">Uutiset</a>
      <a aria-current={currentPath === '/stagella/' ? 'page' : undefined} href="/stagella/">Stagella</a>
      <a aria-current={currentPath === '/yrityksille/' ? 'page' : undefined} href="/yrityksille/">Yrityksille</a>
      <a aria-current={currentPath === '/mika-ai-etta/' ? 'page' : undefined} href="/mika-ai-etta/">Mikä AI ETTÄ!?</a>
      <a class="mobile-topic-link" href="mailto:work@jarkkomoilanen.com?subject=Aihe-ehdotus">Ehdota aihetta</a>
    </nav>
  </details>
  <a class="outline-button compact" href="mailto:work@jarkkomoilanen.com?subject=Aihe-ehdotus">Ehdota aihetta <span aria-hidden="true">↗</span></a>
</header>
