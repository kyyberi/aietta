---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { formatNewsDate, limitNewsWords, MAXIMUM_NEWS_ITEMS, sortNewsByDate } from '../../data/news';

const newsItems = sortNewsByDate(await getCollection('uutiset', ({ data }) => !data.draft)).slice(0, MAXIMUM_NEWS_ITEMS);
---

<BaseLayout title="Uutiset — AI ETTÄ!" description="AI ETTÄ! -yhteisön lyhyet ajankohtaiset ilmoitukset.">
  <main class="news-main">
    <div class="top-shape" aria-hidden="true"></div>
    <div class="shell">
      <Header currentPath="/uutiset/" />
      <section class="news-hero" aria-labelledby="news-title">
        <p class="eyebrow"><span></span> UUTISET</p>
        <h1 id="news-title">Ajankohtaista<br /><em>AI ETTÄ!stä.</em></h1>
        <p>Lyhyitä ilmoituksia yhteisön tapahtumista, julkaisuista ja muista ajankohtaisista asioista.</p>
      </section>

      {newsItems.length > 0 ? (
        <section class="news-list" aria-label="Uusimmat ilmoitukset">
          {newsItems.map((item) => (
            <article class="news-item">
              <time datetime={item.data.publishedAt.toISOString()}>{formatNewsDate(item.data.publishedAt)}</time>
              <div>
                <h2><a href={`/uutiset/${item.data.slug}/`}>{item.data.topic}</a></h2>
                <p>{limitNewsWords(item.body)}</p>
                <a class="text-link" href={`/uutiset/${item.data.slug}/`}>Lue ilmoitus</a>
              </div>
            </article>
          ))}
        </section>
      ) : (
        <section class="news-empty" aria-labelledby="news-empty-title">
          <p class="insight-type">AJANKOHTAISTA</p>
          <h2 id="news-empty-title">Ensimmäiset uutiset ovat tulossa.</h2>
          <p>Julkaisemme täällä yhteisön lyhyet, ajankohtaiset ilmoitukset.</p>
        </section>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
