---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { formatNewsDate, limitNewsWords } from '../../data/news';

export async function getStaticPaths() {
  return (await getCollection('uutiset', ({ data }) => !data.draft)).map((item) => ({
    params: { slug: item.data.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<BaseLayout title={`${item.data.topic} — AI ETTÄ!`} description={limitNewsWords(item.body)}>
  <main class="news-detail-main">
    <div class="top-shape" aria-hidden="true"></div>
    <div class="shell">
      <Header currentPath="/uutiset/" />
      <article class="news-detail">
        <a class="back-link" href="/uutiset/">← Kaikki uutiset</a>
        <time datetime={item.data.publishedAt.toISOString()}>{formatNewsDate(item.data.publishedAt)}</time>
        <h1>{item.data.topic}</h1>
        <p>{limitNewsWords(item.body)}</p>
        {item.data.link && <a class="text-link" href={item.data.link}>{item.data.linkLabel ?? 'Lue lisää'}</a>}
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
