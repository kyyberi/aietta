---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import EventCard from '../components/EventCard.astro';
import InsightCard from '../components/InsightCard.astro';
import { events } from '../data/events';
import { sortInsightsByDate } from '../data/insights';
import { formatNewsDate, sortNewsByDate } from '../data/news';

const nextEvent = events.find((event) => event.published);
const latestInsights = sortInsightsByDate(await getCollection('oivallukset', ({ data }) => !data.draft)).slice(0, 3);
const latestNews = sortNewsByDate(await getCollection('uutiset', ({ data }) => !data.draft)).slice(0, 5);
---

<BaseLayout title="AI ETTÄ! — Ideoista vaikuttaviin AI-ratkaisuihin" description="AI ETTÄ! on avoin suomalainen data- ja tekoäly-yhteisö. Tule mukaan maksuttomiin keskusteluihin datasta, tekoälystä ja vaikuttavista AI-ratkaisuista.">
  <main>
    <div class="home-hero">
      <div class="top-shape" aria-hidden="true"></div>
      <div class="shell hero-shell">
        <Header />
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy reveal">
            <p class="eyebrow"><span></span> AVOIN SUOMALAINEN AI-YHTEISÖ</p>
            <h1 id="hero-title">Ideoista vaikuttaviin<br /><em>AI-ratkaisuihin</em></h1>
            <p class="intro">Rohkeita kysymyksiä, erilaisia näkökulmia ja ihmisiä, jotka haluavat saada aikaan muutosta. Tule mukaan keskustelemaan datasta ja tekoälystä.</p>
            <div class="hero-actions">
              <a class="orange-button" href="#tulevat">Tule mukaan <span aria-hidden="true">↗</span></a>
              <a class="outline-button" href="/mika-ai-etta/">Mistä on kyse?</a>
            </div>
          </div>
          <HeroIllustration />
        </section>
      </div>
    </div>

    <section class="home-band home-events-band" aria-labelledby="events-title">
      <div class="shell home-section-grid home-events-grid">
        <div class="home-section-aside">
          <p class="eyebrow"><span></span> TAPAHTUMAT</p>
          <h2 id="events-title">Kohdataan<br /><em>AI ETTÄ!ssä.</em></h2>
          <p>Maksuttomia keskusteluja ihmisille, jotka haluavat viedä dataa ja tekoälyä käytäntöön.</p>
        </div>
        <div class="home-section-content">
          {nextEvent && <EventCard event={nextEvent} />}
          <section class="past-events" id="menneet" aria-labelledby="past-title">
            <div>
              <p class="section-kicker">AIEMMAT TAPAHTUMAT</p>
              <h3 id="past-title">Menneet tapahtumat</h3>
            </div>
            <div class="empty-state">
              <span aria-hidden="true">✦</span>
              <p>Ensimmäiset keskustelut ovat vasta edessä. Täältä löydät myöhemmin aiemmat aiheet ja keskusteluhavainnot.</p>
            </div>
          </section>
        </div>
      </div>
    </section>

    {latestNews.length > 0 && (
      <section class="home-band home-news-band" aria-labelledby="home-news-title">
        <div class="shell home-section-grid">
          <div class="home-section-aside">
            <p class="eyebrow"><span></span> UUTISET</p>
            <h2 id="home-news-title">Ajankohtaista<br /><em>AI ETTÄ!stä.</em></h2>
            <p>Yhteisön tapahtumat, julkaisut ja muut tuoreet ilmoitukset samassa virrassa.</p>
            <a class="text-link" href="/uutiset/">Kaikki uutiset</a>
          </div>
          <section class="home-news" aria-label="Tuoreimmat uutiset">
            <ol>
              {latestNews.map((item) => (
                <li>
                  <time datetime={item.data.publishedAt.toISOString()}>{formatNewsDate(item.data.publishedAt)}</time>
                  <a href={`/uutiset/#${item.data.slug}`}>{item.data.topic}</a>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </section>
    )}

    <section class="home-band home-enterprise-band" aria-labelledby="enterprise-home-title">
      <div class="shell home-section-grid home-enterprise">
        <div class="home-section-aside">
          <p class="eyebrow"><span></span> AI ETTÄ! YRITYKSILLE</p>
          <h2 id="enterprise-home-title">AI ETTÄ! myös yrityksille</h2>
        </div>
        <div class="home-enterprise-copy">
          <p>Oma AI- ja datatuoteseminaari, ohjattu työpaja tai tuki ratkaisun toteutukseen.</p>
          <a class="outline-button" href="/yrityksille/">Tutustu yrityspalveluihin</a>
        </div>
      </div>
    </section>

    {latestInsights.length > 0 && (
      <section class="home-band home-insights-band" aria-labelledby="home-insights-title">
        <div class="shell home-section-grid">
          <div class="home-section-aside">
            <p class="eyebrow"><span></span> OIVALLUKSET</p>
            <h2 id="home-insights-title">Tuoreimmat oivallukset</h2>
            <p>Kirjoituksia data- ja tekoälytyön suunnasta, käytännöistä ja vaikutuksista.</p>
            <a class="text-link" href="/oivallukset/">Kaikki kirjoitukset</a>
          </div>
          <div class="insight-grid">
            {latestInsights.map((insight) => <InsightCard insight={insight} />)}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
