---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InsightCard from '../../components/InsightCard.astro';
import { events, formatEventDate } from '../../data/events';
import { sortInsightsByDate } from '../../data/insights';

export function getStaticPaths() {
  return events.filter((event) => event.published).map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;
const eventUrl = new URL(`/tapahtumat/${event.slug}/`, Astro.site ?? 'https://aietta.net').href;
const relatedInsights = sortInsightsByDate(
  (await getCollection('oivallukset', ({ data }) => !data.draft)).filter((insight) => insight.data.relatedEventId === event.id),
);
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description: event.description,
  startDate: event.startTime,
  endDate: event.endTime,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'VirtualLocation',
    url: eventUrl,
  },
  organizer: {
    '@type': 'Organization',
    name: 'AI ETTÄ!',
    url: 'https://aietta.net/',
  },
  offers: {
    '@type': 'Offer',
    url: eventUrl,
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout title={`${event.title} — AI ETTÄ!`} description={event.description}>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)}></script>
  <main>
    <div class="top-shape" aria-hidden="true"></div>
    <div class="shell">
      <Header currentPath="/tapahtumat/" />
      <article class="event-page">
        <a class="back-link" href="/#tulevat">← Kaikki tapahtumat</a>
        <p class="eyebrow"><span></span> MAKSUTON ONLINE-KESKUSTELU</p>
        <h1>{event.title}</h1>
        <p class="event-lead">{event.subtitle}</p>
        <div class="event-details">
          <div><span>Päivä ja aika</span><strong>{formatEventDate(event.startTime)} Suomen aikaa</strong></div>
          <div><span>Muoto</span><strong>Maksuton online-keskustelu</strong></div>
          <div><span>Tallenne</span><strong>Tilaisuutta ei tallenneta</strong></div>
        </div>
        <section class="event-body-grid">
          <div>
            <h2>Mistä keskustellaan?</h2>
            <p>{event.description}</p>
            <h2>Ohjelma</h2>
            <ol class="agenda">
              {event.agenda.map((item) => <li>{item}</li>)}
            </ol>
          </div>
          {event.registrationStatus === 'open' && event.registrationFormId ? (
            <aside class="registration-panel registration-open" id="ilmoittaudu">
              <p class="event-kicker">Tule mukaan</p>
              <p class="registration-guidance">Syötä sähköpostiosoitteesi ja lähetä ilmoittautuminen. Osallistumislinkki lähetetään ilmoittautuneille sähköpostitse ennen tilaisuutta.</p>
              {typeof event.registrationCount === 'number' && event.registrationCount > 0 && (
                <p class="registration-count">Jo <strong>{event.registrationCount}</strong> henkilöä on ilmoittautunut mukaan.</p>
              )}
              <div class="registration-form-slot">
                <div class="ml-embedded" data-form={event.registrationFormId}></div>
                <p class="registration-form-fallback" data-embedded-form-fallback hidden role="status">
                  Ilmoittautumislomake ei latautunut. Jos käytät sisällönestoa, kokeile sallia MailerLite tai
                  <a href={`mailto:work@jarkkomoilanen.com?subject=${encodeURIComponent(`Ilmoittautuminen: ${event.title}`)}`}>ilmoittaudu sähköpostilla</a>.
                </p>
              </div>
            </aside>
          ) : (
            <aside class="registration-panel" id="ilmoittaudu">
              <p class="event-kicker">Tule mukaan</p>
              <h2>Ilmoittautuminen avautuu pian.</h2>
              <p>Tilaisuus on maksuton. Tällä sivulla julkaistaan ilmoittautumislinkki, kun se on avoinna.</p>
            </aside>
          )}
        </section>
        {event.audience && (
          <section class="audience-section">
            <div>
              <p class="event-kicker">Kenelle</p>
              <h2>Kenelle tilaisuus on tarkoitettu?</h2>
            </div>
            <div class="audience-copy">
              {event.audience.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>
        )}
        <section class="speaker-section">
          <p class="event-kicker">Keskustelijat</p>
          <h2>Kolme näkökulmaa, yksi yhteinen keskustelu.</h2>
          <div class="speaker-detail-grid">
            {event.speakers.map((speaker) => (
              <article class="speaker-detail">
                {speaker.photo ? (
                  <img class="speaker-detail-photo" src={speaker.photo} alt={speaker.name} width="144" height="144" loading="lazy" decoding="async" />
                ) : (
                  <span class="speaker-placeholder large" aria-hidden="true">{speaker.name.split(' ').map((part) => part[0]).join('')}</span>
                )}
                <h3>{speaker.name}</h3>
                <p class="speaker-title">{speaker.title}</p>
                <h4>{speaker.topic}</h4>
                <p>{speaker.description}</p>
                {speaker.discussionPrompt && <p class="discussion-prompt">{speaker.discussionPrompt}</p>}
              </article>
            ))}
          </div>
        </section>
        {relatedInsights.length > 0 && (
          <section class="related-insights event-insights" aria-labelledby="event-insights-title">
            <div>
              <p class="eyebrow"><span></span> OIVALLUKSET</p>
              <h2 id="event-insights-title">Tapahtuman oivallukset</h2>
            </div>
            <div class="insight-grid">
              {relatedInsights.map((insight) => <InsightCard insight={insight} />)}
            </div>
          </section>
        )}
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
